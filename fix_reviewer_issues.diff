// formatProcPath formats "/proc/<pid>/<suffix>" without allocation overhead.
func formatProcPath(pid int32, suffix string) string {
	// A typical 32-bit PID is up to 10 digits. "/proc//\x00" is 8, plus suffix length.
	// 32 bytes is plenty.
	var buf [32]byte
	n := copy(buf[:], "/proc/")
	n += appendDecimal(buf[n:], uint64(pid))
	buf[n] = '/'
	n++
	n += copy(buf[n:], suffix)
	return string(buf[:n])
}
